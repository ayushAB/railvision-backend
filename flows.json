        "z": "7f0e4efff34ae739",
        "name": "Store Latest Track",
        "func": "// Get current tracks\nlet tracks = global.get(\"tracks\") || {};\n\n// Current time\nconst now = new Date();\n\n// Update track\ntracks[msg.payload.trackId] = {\n    ...msg.payload,\n    timestamp: now.toISOString(),   // 2026-07-26T13:55:20.123Z\n    lastUpdated: Date.now()         // 1785074120123\n};\n\n// Save\nglobal.set(\"tracks\", tracks);\n\n// Send all tracks to websocket\nmsg.payload = Object.values(tracks);\n\nreturn msg;",
