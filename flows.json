        "z": "7f0e4efff34ae739",
        "name": "Store Latest Track",
        "func": "let tracks = global.get(\"tracks\") || {};\n\nconst now = new Date();\n\ntracks[msg.payload.trackId] = {\n    ...msg.payload,\n    timestamp: now.toISOString(),\n    lastUpdated: Date.now()\n};\n\nglobal.set(\"tracks\", tracks);\n\n// Send complete system state\nmsg.payload = {\n    timestamp: now.toISOString(),\n    tracks: Object.values(tracks)\n};\n\nreturn msg;",
